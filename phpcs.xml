<?xml version="1.0"?>
<ruleset name="SRF London Theme">
  <description>Static analysis rules for the SRF London Sage theme.</description>

  <!-- Scan these files -->
  <file>functions.php</file>
  <file>index.php</file>
  <file>app</file>

  <!-- Show colors in console -->
  <arg name="colors"/>

  <!-- Show sniff codes in all reports -->
  <arg value="s"/>

  <arg name="extensions" value="php"/>
  <config name="testVersion" value="8.3-8.4"/>

  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>public/*</exclude-pattern>
  <exclude-pattern>resources/views/*</exclude-pattern>

  <rule ref="PHPCompatibilityWP"/>

  <rule ref="WordPress.Security.EscapeOutput">
    <exclude-pattern>functions.php</exclude-pattern>
    <exclude-pattern>index.php</exclude-pattern>
  </rule>
  <rule ref="WordPress.Security.NonceVerification"/>
  <rule ref="WordPress.PHP.StrictInArray"/>
  <rule ref="WordPress.WP.EnqueuedResourceParameters"/>
  <rule ref="Universal.Operators.StrictComparisons"/>
</ruleset>
