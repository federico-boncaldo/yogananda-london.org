{
  "name": "sage",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "qa:static": "node scripts/qa/static-check.mjs",
    "qa:audit": "node scripts/qa/security-audit.mjs",
    "qa:theme": "npm run qa:static && npm test && npm run build",
    "qa:wp": "node scripts/qa/wp-baseline.mjs",
    "qa:site": "node --test scripts/qa/site-health.test.mjs",
    "qa:visual": "node scripts/qa/visual-smoke.mjs",
    "qa:local": "npm run qa:theme && npm run qa:audit && npm run qa:wp && npm run qa:site",
    "lint": "npm run lint:js && npm run lint:styles",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"resources/assets/styles/**/*.scss\"",
    "format": "prettier --check eslint.config.js \"scripts/qa/**/*.mjs\" \"tests/**/*.mjs\" \"docs/**/*.md\" package.json .prettierrc.json .stylelintrc.json",
    "precommit": "npm run qa:static && npm test && npm run lint",
    "prepush": "npm run qa:audit",
    "prepare": "husky",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . ./resources/lang/sage.pot --include=\"theme.json,patterns,app,resources\"",
    "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/sage.pot $file; done",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@roots/vite-plugin": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^3.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "sass": "^1.85.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "bootstrap": "v4.3.1",
    "jquery": "^3.3.1",
    "popper.js": "^1.14.7"
  }
}
